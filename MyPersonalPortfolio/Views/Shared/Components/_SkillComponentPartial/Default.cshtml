@model List<MyPersonalPortfolio.DAL.Entities.Skill>

<div class="col-six tab-full right">

    <h3>Teknik Yeteneklerim</h3>

    <ul class="skill-bars">

        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];

            <li class="skill-item @(i >= 5 ? "extra-skill" : "")"
                style="@(i >= 5 ? "display:none;" : "")">

                <div class="progress" style="width:@item.Value%">
                    <span>@item.Value%</span>
                </div>

                <strong>@item.Title</strong>

            </li>
        }

    </ul>

    @if (Model.Count > 5)
    {
        <div class="text-center" style="margin-top:20px;">
            <button id="toggleSkills" class="btn btn--stroke">
                Tümünü Göster
            </button>
        </div>
    }

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const btn = document.getElementById("toggleSkills");

        if (!btn) return;

        btn.addEventListener("click", function () {

            const skills = document.querySelectorAll(".extra-skill");

            const hidden = skills[0].style.display === "none";

            skills.forEach(function (item) {
                item.style.display = hidden ? "block" : "none";
            });

            btn.innerText = hidden ? "Daha Az Göster" : "Tümünü Göster";

        });

    });
</script>