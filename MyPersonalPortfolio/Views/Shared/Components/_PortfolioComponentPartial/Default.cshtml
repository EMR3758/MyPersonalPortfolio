@model List<MyPersonalPortfolio.DAL.Entities.Portfolio>

<section id="works" class="s-works target-section">

    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full">
            <h3>Portföy</h3>
            <h1>Son Projelerim</h1>

            <p class="lead">
                Web, mobil ve masaüstü alanlarında geliştirdiğim projelerden bazılarını aşağıda inceleyebilirsiniz.
                Her proje, farklı teknolojiler kullanılarak gerçek ihtiyaçlara yönelik çözümler sunmaktadır.
            </p>
        </div>
    </div>

    <div class="row" style="display:flex; flex-wrap:wrap;">

        @foreach (var item in Model)
        {
            <div style="width:50%; padding:15px;">

                <div class="item-folio">

                    <div class="item-folio__thumb">

                        <a href="@item.ImageUrl"
                           class="thumb-link"
                           title="@item.Title"
                           data-size="1050x700">

                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 style="width:100%;
                            height:320px;
                            object-fit:cover;">

                            <span class="shadow-overlay"></span>

                        </a>

                    </div>

                    <div class="item-folio__text">

                        <h3 class="item-folio__title">
                            @item.Title
                        </h3>

                        <p class="item-folio__cat">
                            @item.SubTitle
                        </p>

                    </div>

                    <a href="@item.Url"
                       class="item-folio__project-link"
                       target="_blank">
                        <i class="im im-link"></i>
                    </a>

                    <div class="item-folio__caption">
                        <p>@item.Description</p>
                    </div>

                </div>

            </div>
        }

    </div>

</section>