@model MyPersonalPortfolio.DAL.Entities.Testimonial

@{
    ViewData["Title"] = "Yeni Yorum";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Yorum İşlemleri</h4>

        <div class="card">

            <div class="card-header">
                <div class="card-title">Yeni Yorum Ekle</div>
            </div>

            <form method="post">

                <div class="card-body">

                    <div class="form-group">
                        <label>Ad Soyad</label>
                        <input type="text" asp-for="NameSurname" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Ünvan</label>
                        <input type="text" asp-for="Title" class="form-control"
                               placeholder="Örn: Software Engineer" />
                    </div>

                    <div class="form-group">
                        <label>Fotoğraf URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Yorum</label>
                        <textarea asp-for="Comment" rows="6" class="form-control"></textarea>
                    </div>

                </div>

                <div class="card-footer">

                    <button class="btn btn-primary">
                        <i class="la la-save"></i> Kaydet
                    </button>

                    <a href="/Testimonial/Index" class="btn btn-secondary">
                        <i class="la la-arrow-left"></i> Geri Dön
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>
