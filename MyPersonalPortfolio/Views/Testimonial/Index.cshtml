@model List<MyPersonalPortfolio.DAL.Entities.Testimonial>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="page-title">Yorumlar</h4>

            <a href="/Testimonial/CreateTestimonial" class="btn btn-primary">
                <i class="la la-plus"></i> Yeni Yorum
            </a>
        </div>

        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-6">

                    <div class="card shadow-sm mb-4">

                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <img src="@item.ImageUrl"
                                     width="70"
                                     height="70"
                                     class="rounded-circle mr-3"
                                     style="object-fit:cover;border:3px solid #f1f1f1;" />

                                <div>

                                    <h5 class="mb-0">@item.NameSurname</h5>

                                    <small class="text-muted">
                                        @item.Title
                                    </small>

                                </div>

                            </div>

                            <hr />

                            <p class="text-dark">
                                "@item.Comment"
                            </p>

                            <div class="text-right">

                                <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId"
                                   class="btn btn-success btn-sm">
                                    <i class="la la-edit"></i> Güncelle
                                </a>

                                <a href="/Testimonial/DeleteTestimonial/@item.TestimonialId"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Bu yorum silinsin mi?')">
                                    <i class="la la-trash"></i> Sil
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</div>