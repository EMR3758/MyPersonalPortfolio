@model List<Experience>

@{
    ViewData["Title"] = "ExperienceList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="main-panel">

    <div class="content">
        <div class="container-fluid">

            <h4 class="page-title">Deneyimler</h4>

            <div class="row">
                <div class="col-md-12">

                    <div class="card">

                        <div class="card-header">
                            <div class="card-title">Deneyim Listesi</div>
                        </div>

                        <div class="card-body">

                            <div class="card-sub">
                                Deneyimler ile ilgili işlemleri aşağıdaki panelden yapabilirsiniz.
                            </div>

                            <div class="table-responsive">

                                <table class="table table-hover">

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Başlık</th>
                                            <th>Unvan</th>
                                            <th>Tarih</th>
                                            <th>Sil</th>
                                            <th>Güncelle</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.ExperienceId</td>
                                                <td>@item.Head</td>
                                                <td>@item.Title</td>
                                                <td>@item.Date</td>

                                                <td>
                                                    <a href="/Experience/DeleteExperience/@item.ExperienceId"
                                                       class="btn btn-danger btn-sm">
                                                        Sil
                                                    </a>
                                                </td>

                                                <td>
                                                    <a href="/Experience/UpdateExperience/@item.ExperienceId"
                                                       class="btn btn-success btn-sm">
                                                        Güncelle
                                                    </a>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                            <a href="/Experience/CreateExperience/"
                               class="btn btn-primary mt-3">
                                Yeni Deneyim Ekle
                            </a>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>