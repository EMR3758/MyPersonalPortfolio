@model MyPersonalPortfolio.DAL.Entities.ToDoList

@{
    ViewData["Title"] = "Yeni Görev";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Yeni Görev Ekle</h4>

        <div class="row">
            <div class="col-md-12">

                <div class="card">

                    <div class="card-header">
                        <div class="card-title">Görev Bilgileri</div>
                    </div>

                    <form method="post">

                        <div class="card-body">

                            <div class="form-group">
                                <label>Görev Başlığı</label>
                                <input type="text"
                                       asp-for="Title"
                                       class="form-control"
                                       placeholder="Görev başlığını giriniz..." />
                            </div>

                            <div class="form-group">
                                <label>İkon (Line Awesome)</label>
                                <input type="text"
                                       asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="Örn: la la-code" />
                                <small class="text-muted">
                                    Örnek: la la-code, la la-laptop, la la-database
                                </small>
                            </div>

                            <div class="form-group">
                                <label>Tarih</label>
                                <input type="date"
                                       asp-for="Date"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Durum</label>

                                <select asp-for="Status" class="form-control">
                                    <option value="false">Bekliyor</option>
                                    <option value="true">Tamamlandı</option>
                                </select>

                            </div>

                        </div>

                        <div class="card-footer">

                            <button class="btn btn-primary">
                                <i class="la la-save"></i> Kaydet
                            </button>

                            <a href="/ToDoList/Index"
                               class="btn btn-danger">
                                <i class="la la-times"></i> Vazgeç
                            </a>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>