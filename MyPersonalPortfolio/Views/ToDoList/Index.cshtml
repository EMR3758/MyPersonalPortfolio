@model List<MyPersonalPortfolio.DAL.Entities.ToDoList>

@{
    ViewData["Title"] = "Yapılacaklar";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h3 class="mb-2">
                            ✅ Yapılacaklar Yönetimi
                        </h3>

                        <p class="text-muted mb-2">
                            Görevlerinizi buradan ekleyebilir, güncelleyebilir ve tamamlanma durumlarını takip edebilirsiniz.
                        </p>

                        <span class="badge badge-success mr-2">
                            Tamamlanan: @ViewBag.Completed
                        </span>

                        <span class="badge badge-warning">
                            Bekleyen: @ViewBag.Pending
                        </span>

                    </div>

                    <div>
                        <i class="la la-check-square text-success" style="font-size:70px;"></i>
                    </div>

                </div>

            </div>
        </div>

        <h4 class="page-title">Yapılacaklar Listesi</h4>

        <div class="row">
            <div class="col-md-12">

                <div class="card">

                    <div class="card-header">
                        <div class="card-title">Görev Listesi</div>
                    </div>

                    <div class="card-body">

                        <a href="/ToDoList/CreateToDoList" class="btn btn-primary mb-3">
                            <i class="la la-plus"></i> Yeni Görev Ekle
                        </a>

                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Görev</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr>

                                            <td>@item.ToDoListId</td>

                                            <td>@item.Title</td>

                                            <td>
                                                @if (item.Status)
                                                {
                                                    <span class="badge badge-success">
                                                        Tamamlandı
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">
                                                        Bekliyor
                                                    </span>
                                                }
                                            </td>

                                            <td>

                                                <a href="/ToDoList/ChangeStatus/@item.ToDoListId"
                                                   class="btn btn-dark btn-sm">
                                                    <i class="la la-refresh"></i>
                                                </a>

                                                <a href="/ToDoList/UpdateToDoList/@item.ToDoListId"
                                                   class="btn btn-success btn-sm">
                                                    <i class="la la-edit"></i>
                                                </a>

                                                <a href="/ToDoList/DeleteToDoList/@item.ToDoListId"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Görev silinsin mi?')">
                                                    <i class="la la-trash"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>