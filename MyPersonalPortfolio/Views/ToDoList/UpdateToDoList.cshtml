@model MyPersonalPortfolio.DAL.Entities.ToDoList

@{
    ViewData["Title"] = "Görev Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Görev Güncelle</h4>

        <div class="row">
            <div class="col-md-12">

                <div class="card">

                    <div class="card-header">
                        <div class="card-title">Görev Bilgilerini Güncelle</div>
                    </div>

                    <form method="post">

                        <input type="hidden" asp-for="ToDoListId" />

                        <div class="card-body">

                            <div class="form-group">
                                <label>Görev Başlığı</label>
                                <input type="text"
                                       asp-for="Title"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>İkon</label>
                                <input type="text"
                                       asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="Örn: la la-code" />
                            </div>

                            <div class="form-group">
                                <label>Tarih</label>
                                <input type="date"
                                       asp-for="Date"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Durum</label>

                                <select asp-for="Status" class="form-control">

                                    @if (Model.Status)
                                    {
                                        <option value="true" selected>Tamamlandı</option>
                                        <option value="false">Bekliyor</option>
                                    }
                                    else
                                    {
                                        <option value="false" selected>Bekliyor</option>
                                        <option value="true">Tamamlandı</option>
                                    }

                                </select>
                            </div>

                        </div>

                        <div class="card-footer">

                            <button class="btn btn-success">
                                <i class="la la-save"></i> Güncelle
                            </button>

                            <a href="/ToDoList/Index"
                               class="btn btn-danger">
                                <i class="la la-times"></i> İptal
                            </a>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>