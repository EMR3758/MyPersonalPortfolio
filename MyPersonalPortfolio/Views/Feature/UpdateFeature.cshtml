@model MyPersonalPortfolio.DAL.Entities.Feature

@{
    ViewData["Title"] = "Özellik Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Özellik Güncelle</h4>

        <div class="card">

            <div class="card-header">
                <div class="card-title">Feature Güncelle</div>
            </div>

            <form method="post">

                <input type="hidden" asp-for="FeatureId" />

                <div class="card-body">

                    <div class="form-group">
                        <label>Başlık</label>
                        <input asp-for="Title" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Açıklama</label>
                        <textarea asp-for="Description"
                                  rows="6"
                                  class="form-control"></textarea>
                    </div>

                </div>

                <div class="card-footer">

                    <button class="btn btn-success">
                        Güncelle
                    </button>

                    <a href="/Feature/Index"
                       class="btn btn-danger">
                        İptal
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>