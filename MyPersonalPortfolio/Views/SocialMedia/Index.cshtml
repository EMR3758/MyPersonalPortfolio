@model List<MyPersonalPortfolio.DAL.Entities.SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Sosyal Medya İşlemleri</h4>

        <div class="card">

            <div class="card-header">
                <div class="card-title">Sosyal Medya Listesi</div>
            </div>

            <div class="card-body">

                <a href="/SocialMedia/CreateSocialMedia" class="btn btn-primary mb-3">
                    <i class="la la-plus"></i> Yeni Sosyal Medya
                </a>

                <table class="table table-hover table-bordered">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>İkon</th>
                            <th>Platform</th>
                            <th>Link</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.SocialMediaId</td>

                                <td style="font-size:22px">
                                    <i class="@item.Icon"></i>
                                </td>

                                <td>@item.Title</td>

                                <td>
                                    <a href="@item.Url"
                                       target="_blank"
                                       class="btn btn-info btn-sm">
                                        <i class="la la-external-link"></i> Git
                                    </a>
                                </td>

                                <td>
                                    <a href="/SocialMedia/DeleteSocialMedia/@item.SocialMediaId"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Silinsin mi?')">
                                        <i class="la la-trash"></i> Sil
                                    </a>
                                </td>

                                <td>
                                    <a href="/SocialMedia/UpdateSocialMedia/@item.SocialMediaId"
                                       class="btn btn-success btn-sm">
                                        <i class="la la-edit"></i> Güncelle
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>