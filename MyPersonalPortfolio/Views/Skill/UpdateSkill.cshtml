@model MyPersonalPortfolio.DAL.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <h4 class="page-title">Yetenek Güncelle</h4>

        <div class="card">

            <div class="card-header">
                <div class="card-title">Yetenek Güncelleme</div>
            </div>

            <form method="post">

                <input type="hidden" asp-for="SkillId" />

                <div class="card-body">

                    <div class="form-group">
                        <label>Yetenek Adı</label>
                        <input asp-for="Title" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Seviye (%)</label>
                        <input asp-for="Value"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />
                    </div>

                </div>

                <div class="card-footer">

                    <button class="btn btn-success">
                        Güncelle
                    </button>

                    <a href="/Skill/Index"
                       class="btn btn-danger">
                        İptal
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>
