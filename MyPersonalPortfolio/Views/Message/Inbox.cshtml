@model List<Message>

@{
    ViewData["Title"] = "Inbox";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h3 class="mb-2">
                            📩 Gelen Mesajlar
                        </h3>

                        <p class="text-muted mb-2">
                            İletişim formu üzerinden gönderilen mesajları görüntüleyebilir, okuyabilir, durumlarını güncelleyebilir veya silebilirsiniz.
                        </p>

                        <span class="badge badge-primary mr-2">
                            Toplam Mesaj: @Model.Count
                        </span>

                        <span class="badge badge-success mr-2">
                            Okunan: @Model.Count(x => x.IsRead)
                        </span>

                        <span class="badge badge-danger">
                            Okunmamış: @Model.Count(x => !x.IsRead)
                        </span>

                    </div>

                    <div>
                        <i class="la la-envelope text-primary" style="font-size:70px;"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="row">
            <div class="col-md-12">

                <div class="card">

                    <div class="card-header">
                        <div class="card-title">Mesaj Listesi</div>
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Gönderen</th>
                                        <th>Konu</th>
                                        <th>Tarih</th>
                                        <th>Durum</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr>

                                            <td>@item.MessageId</td>
                                            <td>@item.NameSurname</td>
                                            <td>@item.Subject</td>
                                            <td>@item.SendDate.ToString("dd.MM.yyyy")</td>

                                            <td>
                                                @if (item.IsRead)
                                                {
                                                    <span class="badge badge-success">Okundu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Yeni</span>
                                                }
                                            </td>

                                            <td class="text-center">

                                                <a href="/Message/MessageDetail/@item.MessageId"
                                                   class="btn btn-info btn-sm"
                                                   title="Mesajı Aç">
                                                    <i class="la la-envelope"></i>
                                                </a>

                                                <a href="/Message/ChangeStatus/@item.MessageId"
                                                   class="btn btn-dark btn-sm"
                                                   title="Durumu Değiştir">
                                                    <i class="la la-refresh"></i>
                                                </a>

                                                <a href="/Message/DeleteMessage/@item.MessageId"
                                                   class="btn btn-danger btn-sm"
                                                   title="Sil"
                                                   onclick="return confirm('Bu mesaj silinsin mi?')">
                                                    <i class="la la-trash"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>